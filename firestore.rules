rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.admin == true;
    }

    // Users can only access their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // Users can read/create their own trips, update booking selections without tampering with status/userId,
    // and delete only pending trips they own. Admins have full access.
    match /trips/{tripId} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId) || isAdmin();
      allow create: if (request.auth != null &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.status == 'pending') || isAdmin();
      allow update: if isAdmin() || (
        request.auth != null &&
        request.auth.uid == resource.data.userId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status == resource.data.status
      );
      allow delete: if isAdmin() || (
        request.auth != null &&
        request.auth.uid == resource.data.userId &&
        resource.data.status == 'pending'
      );
    }

    // Users can only access their own points
    match /userPoints/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // User submission tracking (for rate limiting - written by submitTrip Cloud Function via Admin SDK)
    match /userSubmissions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // Admin notifications (strictly validated shape for authenticated user message notifications)
    match /adminNotifications/{notificationId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.auth != null &&
        request.resource.data.keys().hasOnly(['type', 'conversationId', 'preview', 'timestamp', 'isRead']) &&
        request.resource.data.isRead == false &&
        request.resource.data.type == 'new_user_message'
      );
    }

    // Trip conversations - users can access conversations for their own trips, admin can access all
    match /tripConversations/{conversationId} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId) || isAdmin();
      allow create: if (request.auth != null && request.auth.uid == request.resource.data.userId) || isAdmin();
      allow update: if isAdmin() || (
        request.auth != null &&
        request.auth.uid == resource.data.userId &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isAdmin();

      // Messages within conversations - users cannot spoof admin messages or alter existing message text
      match /messages/{messageId} {
        allow read: if (request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/tripConversations/$(conversationId)).data.userId) || isAdmin();
        allow create: if isAdmin() || (
          request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/tripConversations/$(conversationId)).data.userId &&
          request.resource.data.senderType == 'user' &&
          request.resource.data.senderId == request.auth.uid
        );
        allow update: if isAdmin() || (
          request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/tripConversations/$(conversationId)).data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        );
        allow delete: if isAdmin();
      }
    }

    // Admin access for processing trips and conversations
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
